@app.route("/public/annonces")
def public_annonces():
    auto_archive()
    a = request.args
    q = "SELECT * FROM annonces WHERE statut='publie'"
    p = []
    now = datetime.now().strftime("%Y-%m-%d")
    q += " AND (date_debut IS NULL OR date_debut <= ?)"; p.append(now)
    q += " AND (date_fin IS NULL OR date_fin >= ?)"; p.append(now)
    if a.get("categorie"): q += " AND categorie=?"; p.append(a.get("categorie"))
    q += " ORDER BY COALESCE(published_at, created_at) DESC LIMIT 100"
    c = connect()
    rows = c.execute(q, p).fetchall()
    c.close()
    return jsonify([dict(r) for r in rows])


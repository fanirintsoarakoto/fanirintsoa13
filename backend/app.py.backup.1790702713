@app.route("/public/actualites")
def public_actualites():
    auto_archive()
    today = datetime.now().strftime("%Y-%m-%d")
    c = connect()
    annonces = c.execute("""SELECT * FROM annonces WHERE statut='publie'
                            AND (date_debut IS NULL OR date_debut <= ?)
                            AND (date_fin IS NULL OR date_fin >= ?)
                            ORDER BY COALESCE(published_at, created_at) DESC LIMIT 6""",
                         (today, today)).fetchall()
    events = c.execute("""SELECT * FROM evenements WHERE statut='publie' AND date_event >= ?
                          ORDER BY date_event ASC LIMIT 4""", (today,)).fetchall()
    c.close()
    return jsonify({"annonces": [dict(r) for r in annonces],
                    "evenements": [dict(r) for r in events]})


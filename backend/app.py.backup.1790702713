# AUTH
# ============================================================
@app.route("/auth/register", methods=["POST"])
def register():
    d = request.json
    u = (d.get("username") or "").strip()
    e = (d.get("email") or "").strip()
    p = d.get("password") or ""
    if not u or not e or not p:
        return jsonify({"error": "Mila anarana, email, teny miafina"}), 400
    c = connect()
    if c.execute("SELECT id FROM users WHERE username=?", (u,)).fetchone():
        c.close(); return jsonify({"error": "Efa misy"}), 400
    cur = c.execute("INSERT INTO users (username,email,password_hash,role,active,prenom,telephone) VALUES (?,?,?,'admin',1,?,?)",
                    (u, e, hash_password(p), d.get("prenom",""), d.get("telephone","")))
    uid = cur.lastrowid
    token = secrets.token_urlsafe(32)
    c.execute("INSERT INTO sessions_auth (token,user_id) VALUES (?,?)", (token, uid))
    c.commit(); c.close()
    log_action(uid, "register")
    perms = get_user_permissions(uid)
    return jsonify({"token": token,
                    "user": {"id": uid, "username": u, "email": e, "role": "admin"},
                    "permissions": perms}), 201

@app.route("/auth/login", methods=["POST"])
def login():
    d = request.json
    u = (d.get("username") or "").strip()
    p = d.get("password") or ""
    c = connect()
    user = c.execute("SELECT * FROM users WHERE username=? OR email=?", (u, u)).fetchone()
    if user and user["locked_until"]:
        try:
            locked = datetime.fromisoformat(user["locked_until"])
            if datetime.now() < locked:
                mins = int((locked - datetime.now()).total_seconds() / 60) + 1
                c.close()
                return jsonify({"error": f"Compte verrouillé. Andraso {mins} min"}), 429
        except: pass
    if not user or not verify_password(p, user["password_hash"]):
        if user:
            c.execute("UPDATE users SET login_attempts=login_attempts+1 WHERE id=?", (user["id"],))
            if user["login_attempts"] + 1 >= 5:
                lock = (datetime.now() + timedelta(minutes=15)).isoformat()
                c.execute("UPDATE users SET locked_until=? WHERE id=?", (lock, user["id"]))
            c.commit()
        c.close()
        log_action(user["id"] if user else None, "login", f"u={u}", resultat="echec")
        return jsonify({"error": "Anarana na teny miafina diso"}), 401
    if not user["active"]:
        c.close(); return jsonify({"error": "Tsy mavitrika"}), 403
    c.execute("UPDATE users SET login_attempts=0, locked_until=NULL, last_login=CURRENT_TIMESTAMP WHERE id=?",
              (user["id"],))
    token = secrets.token_urlsafe(32)
    c.execute("INSERT INTO sessions_auth (token,user_id) VALUES (?,?)", (token, user["id"]))
    c.commit(); c.close()
    log_action(user["id"], "login")
    perms = get_user_permissions(user["id"])
    return jsonify({"token": token,
                    "user": {"id": user["id"], "username": user["username"],
                             "email": user["email"], "role": user["role"],
                             "prenom": user["prenom"], "photo": user["photo"]},
                    "permissions": perms})

@app.route("/auth/me")
def me():
    uid, err = require_auth(request)
    if err: return err
    c = connect()
    u = c.execute("SELECT id,username,email,role,active,prenom,telephone,photo FROM users WHERE id=?", (uid,)).fetchone()
    c.close()
    if not u: return jsonify({"error": "Tsy hita"}), 404
    return jsonify({**dict(u), "permissions": get_user_permissions(uid)})

@app.route("/auth/logout", methods=["POST"])
def logout():
    auth = request.headers.get("Authorization", "")
    if auth.startswith("Bearer "):
        uid = get_user(request)
        c = connect()
        c.execute("DELETE FROM sessions_auth WHERE token=?", (auth[7:],))
        c.commit(); c.close()
        if uid: log_action(uid, "logout")
    return jsonify({"ok": True})


    if not n: return jsonify({"error": "Mila anarana"}), 400
    c = connect()
    try:
        cur = c.execute("INSERT INTO classes (nom, description) VALUES (?,?)", (n, d.get("description","")))
        c.commit()
        row = c.execute("SELECT * FROM classes WHERE id=?", (cur.lastrowid,)).fetchone()

    fields, vals = [], []
    for k in ["nom","coefficient","classe_id"]:
        if k in d: fields.append(f"{k}=?"); vals.append(d[k])
    if not fields: return jsonify({"error": "Tsy misy"}), 400
    vals.append(mid)

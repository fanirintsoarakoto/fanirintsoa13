    c.execute("""CREATE TABLE IF NOT EXISTS notes (
        id INTEGER PRIMARY KEY AUTOINCREMENT, student_id INTEGER NOT NULL,
        matiere_id INTEGER NOT NULL, note REAL NOT NULL,
        type TEXT DEFAULT 'devoir', trimestre INTEGER DEFAULT 1,
        date TEXT DEFAULT CURRENT_DATE, remarque TEXT DEFAULT '',

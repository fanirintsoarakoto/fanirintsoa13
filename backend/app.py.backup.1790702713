        created_at TEXT DEFAULT CURRENT_TIMESTAMP)""")
    c.execute("""CREATE TABLE IF NOT EXISTS frais (
        id INTEGER PRIMARY KEY AUTOINCREMENT, nom TEXT NOT NULL,
        montant REAL DEFAULT 0, type TEXT DEFAULT 'ecolage',
        classe_id INTEGER, created_at TEXT DEFAULT CURRENT_TIMESTAMP)""")
    c.execute("""CREATE TABLE IF NOT EXISTS annonces (
        id INTEGER PRIMARY KEY AUTOINCREMENT, titre TEXT NOT NULL,
        contenu TEXT NOT NULL, image_url TEXT DEFAULT '',
        categorie TEXT DEFAULT 'general', type TEXT DEFAULT 'annonce',
        priorite TEXT DEFAULT 'normale', auteur TEXT DEFAULT 'Admin',
        statut TEXT DEFAULT 'brouillon', date_debut TEXT, date_fin TEXT,
        published_at TEXT, updated_at TEXT, created_by INTEGER,
        created_at TEXT DEFAULT CURRENT_TIMESTAMP)""")
    c.execute("""CREATE TABLE IF NOT EXISTS evenements (
        id INTEGER PRIMARY KEY AUTOINCREMENT, titre TEXT NOT NULL,
        description TEXT DEFAULT '', image_url TEXT DEFAULT '',
        categorie TEXT DEFAULT 'general', type TEXT DEFAULT 'autre',
        statut TEXT DEFAULT 'brouillon',
        date_event TEXT NOT NULL, heure TEXT DEFAULT '', date_fin TEXT,
        lieu TEXT DEFAULT '', published_at TEXT, updated_at TEXT,
        created_by INTEGER,
        created_at TEXT DEFAULT CURRENT_TIMESTAMP)""")
    c.execute("""CREATE TABLE IF NOT EXISTS messages (
        id INTEGER PRIMARY KEY AUTOINCREMENT, expediteur TEXT DEFAULT 'Admin',
        destinataire TEXT, sujet TEXT, contenu TEXT NOT NULL,
        lu INTEGER DEFAULT 0, created_at TEXT DEFAULT CURRENT_TIMESTAMP)""")
    c.execute("""CREATE TABLE IF NOT EXISTS notifications (
        id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER,
        type TEXT DEFAULT 'info', titre TEXT NOT NULL,
        contenu TEXT DEFAULT '', lu INTEGER DEFAULT 0,
        created_at TEXT DEFAULT CURRENT_TIMESTAMP)""")
    c.execute("""CREATE TABLE IF NOT EXISTS parametres (
        cle TEXT PRIMARY KEY, valeur TEXT)""")

    # === MIGRATIONS ANNONCES/EVENTS ===
    for tbl, cols in [
        ("annonces", [("image_url","TEXT DEFAULT ''"),("categorie","TEXT DEFAULT 'general'"),
                      ("statut","TEXT DEFAULT 'brouillon'"),("published_at","TEXT"),
                      ("date_fin","TEXT"),("updated_at","TEXT"),("created_by","INTEGER")]),
        ("evenements", [("image_url","TEXT DEFAULT ''"),("categorie","TEXT DEFAULT 'general'"),
                        ("statut","TEXT DEFAULT 'brouillon'"),("published_at","TEXT"),
                        ("date_fin","TEXT"),("updated_at","TEXT"),("created_by","INTEGER")]),
    ]:
        for col, typ in cols:
            try: c.execute(f"ALTER TABLE {tbl} ADD COLUMN {col} {typ}")
            except sqlite3.OperationalError: pass

    # === SEED ===
    for n in ["Classe A", "Classe B", "Classe C"]:
        try: c.execute("INSERT INTO classes (nom) VALUES (?)", (n,))
        except sqlite3.IntegrityError: pass
    for nom, desc in [("admin","Administrateur"),("responsable","Responsable scan"),
                      ("enseignant","Enseignant"),("comptable","Comptable"),("direction","Direction")]:
        try: c.execute("INSERT INTO roles (nom, description) VALUES (?,?)", (nom, desc))
        except sqlite3.IntegrityError: pass
    perms = [
        ("users.view","Voir users"),("users.create","Créer user"),
        ("users.update","Modifier user"),("users.delete","Suppr user"),
        ("students.view","Voir élèves"),("students.create","Créer élève"),
        ("students.update","Modifier élève"),("students.delete","Suppr élève"),
        ("schedules.view","Voir emploi"),("schedules.create","Créer emploi"),
        ("schedules.update","Modifier emploi"),("schedules.delete","Suppr emploi"),
        ("attendance.view","Voir présence"),("attendance.scan","Scanner"),
        ("attendance.update","Modifier présence"),("attendance.delete","Suppr présence"),
        ("statistics.view","Voir stats"),("reports.export","Exporter"),
        ("logs.view","Voir logs"),("settings.manage","Gérer paramètres"),
    ]
    for code, desc in perms:
        try: c.execute("INSERT INTO permissions (code, description) VALUES (?,?)", (code, desc))
        except sqlite3.IntegrityError: pass
    role_map = {r["nom"]: r["id"] for r in c.execute("SELECT id, nom FROM roles").fetchall()}
    perm_map = {p["code"]: p["id"] for p in c.execute("SELECT id, code FROM permissions").fetchall()}
    role_perms = {
        "admin": list(perm_map.keys()),
        "responsable": ["attendance.view","attendance.scan","students.view"],
        "enseignant": ["students.view","attendance.view","schedules.view","statistics.view"],
        "direction": ["students.view","attendance.view","schedules.view","statistics.view","reports.export","logs.view"],
    }
    for r, codes in role_perms.items():
        for code in codes:
            try:
                c.execute("INSERT OR IGNORE INTO role_permissions (role_id, permission_id) VALUES (?,?)",
                          (role_map[r], perm_map[code]))
            except: pass
    defaults = [
        ("etablissement_nom","Fanirintsoa"),("etablissement_adresse","Antananarivo"),
        ("etablissement_telephone","034 00 000 00"),("etablissement_email","contact@fanirintsoa.mg"),
        ("etablissement_logo",""),("annee_academique","2024-2025"),("devise","Ar"),
        ("tolerance_minutes","10"),("limite_retard_minutes","30"),("doublon_minutes","5"),
        ("notif_retard","1"),("notif_absence","1"),("notif_depart","1"),
        ("note_max","20"),("note_min_pass","10"),("coefficient_max","10"),
        ("bareme_defaut","sur20"),("moyenne_type","ponderee"),("arrondi_decimales","2"),
    ]
    for k, v in defaults:
        try: c.execute("INSERT INTO parametres (cle, valeur) VALUES (?,?)", (k, v))
        except sqlite3.IntegrityError: pass
    # ===== ADMIN PAR DÉFAUT =====
    try:
        existing = c.execute("SELECT id FROM users WHERE username='admin'").fetchone()
        if not existing:
            salt = secrets.token_hex(16)
            h = hashlib.pbkdf2_hmac("sha256", b"fanirintsoa", salt.encode(), 100_000)
            pwd_hash = f"{salt}${h.hex()}"
            c.execute("""INSERT INTO users
                (username, email, password_hash, role, active, prenom, telephone, photo)
                VALUES (?, ?, ?, 'admin', 1, ?, ?, '')""",
                ("admin", "fanirintsoarakoto4@gmail.com", pwd_hash,
                 "Fanirintsoa", "0382861725"))
        for k, v in [
            ("etablissement_nom", "Fanirintsoa"),
            ("etablissement_adresse", "Lot VL 40 A Ampahibato Alasora"),
            ("etablissement_telephone", "0382861725"),
            ("etablissement_email", "fanirintsoarakoto4@gmail.com"),
        ]:
            try:
                c.execute("INSERT OR REPLACE INTO parametres (cle, valeur) VALUES (?,?)", (k, v))
            except: pass
    except Exception as e:
        pass

    # ===== MESSAGES PRO (chat) =====
    try:
        c.execute("ALTER TABLE messages ADD COLUMN sender_id INTEGER")
    except sqlite3.OperationalError: pass
    try:
        c.execute("ALTER TABLE messages ADD COLUMN receiver_id INTEGER")
    except sqlite3.OperationalError: pass
    try:
        c.execute("ALTER TABLE messages ADD COLUMN conversation_id TEXT")
    except sqlite3.OperationalError: pass

    c.commit(); c.close()


init_db()

# ============================================================
# HELPERS
# ============================================================
def hash_password(pw):
    salt = secrets.token_hex(16)
    h = hashlib.pbkdf2_hmac("sha256", pw.encode(), salt.encode(), 100_000)
    return f"{salt}${h.hex()}"

def verify_password(pw, stored):
    try:
        salt, h = stored.split("$", 1)
    except ValueError: return False
    check = hashlib.pbkdf2_hmac("sha256", pw.encode(), salt.encode(), 100_000)
    return secrets.compare_digest(check.hex(), h)

def get_user(req):
    auth = req.headers.get("Authorization", "")
    if not auth.startswith("Bearer "): return None
    token = auth[7:]
    c = connect()
    row = c.execute("SELECT user_id FROM sessions_auth WHERE token=?", (token,)).fetchone()
    c.close()
    return row["user_id"] if row else None

def require_auth(req):
    uid = get_user(req)
    if not uid: return None, (jsonify({"error": "Tsy niditra"}), 401)
    return uid, None

def get_user_permissions(uid):
    c = connect()
    r = c.execute("SELECT role FROM users WHERE id=?", (uid,)).fetchone()
    perms = set()
    if r:
        rows = c.execute("""SELECT p.code FROM permissions p
                            JOIN role_permissions rp ON rp.permission_id = p.id
                            JOIN roles r ON r.id = rp.role_id WHERE r.nom=?""",
                        (r["role"],)).fetchall()
        perms = {x["code"] for x in rows}
    rows = c.execute("""SELECT p.code FROM permissions p
                        JOIN user_permissions up ON up.permission_id = p.id
                        WHERE up.user_id=?""", (uid,)).fetchall()
    perms.update({x["code"] for x in rows})
    c.close()
    return list(perms)

def has_permission(uid, code):
    return code in get_user_permissions(uid)

def require_permission(req, code):
    uid, err = require_auth(req)
    if err: return None, err
    if not has_permission(uid, code):
        log_action(uid, f"refus:{code}", resultat="echec")
        return None, (jsonify({"error": "Tsy manana alalana", "permission": code}), 403)
    return uid, None

def log_action(user_id, action, details="", resultat="succes"):
    try:
        c = connect()
        username = ""
        if user_id:
            u = c.execute("SELECT username FROM users WHERE id=?", (user_id,)).fetchone()
            username = u["username"] if u else ""
        c.execute("INSERT INTO activity_logs (user_id, username, action, details, resultat) VALUES (?,?,?,?,?)",
                  (user_id, username, action, details, resultat))
        c.commit(); c.close()
    except: pass

def client_ip(req):
    return req.headers.get("X-Forwarded-For", req.remote_addr or "")

def gen_matricule():
    c = connect()
    year = datetime.now().year
    row = c.execute("SELECT matricule FROM students WHERE matricule LIKE ? ORDER BY id DESC LIMIT 1",
                    (f"ELV-{year}-%",)).fetchone()
    if row:
        try: n = int(row["matricule"].split("-")[-1]) + 1
        except: n = 1
    else: n = 1
    c.close()
    return f"ELV-{year}-{n:04d}"

def compute_age(dn):
    if not dn: return None
    try:
        d = datetime.strptime(dn, "%Y-%m-%d")
        t = date.today()
        return t.year - d.year - ((t.month, t.day) < (d.month, d.day))
    except: return None

def pget(key, default=0):
    c = connect()
    r = c.execute("SELECT valeur FROM parametres WHERE cle=?", (key,)).fetchone()
    c.close()
    if not r: return default
    try: return int(r["valeur"])
    except: return default

def publication_visible(r):
    if r["statut"] != "publie": return False
    now = datetime.now().strftime("%Y-%m-%d")
    if r["date_debut"] and r["date_debut"] > now: return False
    if r["date_fin"] and r["date_fin"] < now: return False
    return True

def auto_archive():
    try:
        c = connect()
        now = datetime.now().strftime("%Y-%m-%d")
        c.execute("UPDATE annonces SET statut='archive' WHERE statut='publie' AND date_fin IS NOT NULL AND date_fin < ?", (now,))
        c.execute("UPDATE evenements SET statut='archive' WHERE statut='publie' AND date_fin IS NOT NULL AND date_fin < ?", (now,))
        c.commit(); c.close()
    except: pass


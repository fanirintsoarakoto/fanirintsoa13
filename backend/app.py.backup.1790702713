@app.route("/annonces")
def list_annonces_admin():
    uid, err = require_auth(request)
    if err: return err
    a = request.args
    q = "SELECT * FROM annonces WHERE 1=1"
    p = []
    if a.get("statut"): q += " AND statut=?"; p.append(a.get("statut"))
    if a.get("search"):
        s = f"%{a.get('search')}%"
        q += " AND (titre LIKE ? OR contenu LIKE ?)"; p += [s, s]
    q += " ORDER BY id DESC LIMIT 200"
    c = connect()
    rows = c.execute(q, p).fetchall()
    c.close()
    return jsonify([dict(r) for r in rows])

@app.route("/annonces", methods=["POST"])
def add_annonce_admin():
    uid, err = require_auth(request)
    if err: return err
    d = request.json
    t = (d.get("titre") or "").strip()
    if not t: return jsonify({"error": "Mila titre"}), 400
    statut = d.get("statut", "brouillon")
    published_at = datetime.now().isoformat() if statut == "publie" else None
    c = connect()
    cur = c.execute("""INSERT INTO annonces
        (titre, contenu, image_url, categorie, type, priorite, auteur,
         statut, date_debut, date_fin, published_at, created_by)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?)""",
        (t, d.get("contenu",""), d.get("image_url",""),
         d.get("categorie","general"), d.get("type","annonce"),
         d.get("priorite","normale"), d.get("auteur","Admin"),
         statut, d.get("date_debut"), d.get("date_fin"), published_at, uid))
    c.commit()
    row = c.execute("SELECT * FROM annonces WHERE id=?", (cur.lastrowid,)).fetchone()
    c.close()
    return jsonify(dict(row)), 201

@app.route("/annonces/<int:aid>", methods=["PUT"])
def update_annonce_admin(aid):
    uid, err = require_auth(request)
    if err: return err
    d = request.json or {}
    fields, vals = [], []
    for k in ["titre","contenu","image_url","categorie","type","priorite","statut","date_debut","date_fin"]:
        if k in d: fields.append(f"{k}=?"); vals.append(d[k])
    if d.get("statut") == "publie":
        fields.append("published_at=CURRENT_TIMESTAMP")
    fields.append("updated_at=CURRENT_TIMESTAMP")
    vals.append(aid)
    c = connect()
    c.execute(f"UPDATE annonces SET {', '.join(fields)} WHERE id=?", vals)
    c.commit()
    row = c.execute("SELECT * FROM annonces WHERE id=?", (aid,)).fetchone()
    c.close()
    return jsonify(dict(row)) if row else (jsonify({"error": "Tsy hita"}), 404)


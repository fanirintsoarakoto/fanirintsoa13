    q = "SELECT * FROM evenements WHERE statut='publie'"
    p = []
    if a.get("upcoming") == "1":
        q += " AND date_event >= ?"; p.append(today)
    q += " ORDER BY date_event ASC LIMIT 100"
    c = connect()
    rows = c.execute(q, p).fetchall()
    c.close()
    return jsonify([dict(r) for r in rows])


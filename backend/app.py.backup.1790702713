@app.route("/students/<int:sid>/qr")
def student_qr(sid):
    c = connect()
    b = c.execute("SELECT token FROM badges WHERE student_id=?", (sid,)).fetchone()
    if not b:
        token_val = secrets.token_urlsafe(16)
        c.execute("INSERT INTO badges (student_id, token) VALUES (?,?)", (sid, token_val))
        c.commit()
    else:
        token_val = b["token"]
    c.close()
    qr = qrcode.QRCode(version=1, box_size=10, border=4)
    qr.add_data(f"FANIRINTSOA-BADGE:{token_val}")
    qr.make(fit=True)
    img = qr.make_image(fill_color="black", back_color="white")
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    buf.seek(0)
    return send_file(buf, mimetype="image/png")


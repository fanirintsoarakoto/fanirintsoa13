    c.execute("""CREATE TABLE IF NOT EXISTS attendance_sessions (
        id INTEGER PRIMARY KEY AUTOINCREMENT, classe_id INTEGER,
        groupe_id INTEGER, date TEXT NOT NULL, heure_debut TEXT,
        heure_fin TEXT, statut TEXT DEFAULT 'open',

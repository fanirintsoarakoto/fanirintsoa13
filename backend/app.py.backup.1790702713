    c.execute("""CREATE TABLE IF NOT EXISTS emploi_temps (
        id INTEGER PRIMARY KEY AUTOINCREMENT, classe_id INTEGER,
        jour TEXT, heure_debut TEXT, heure_fin TEXT, matiere TEXT,

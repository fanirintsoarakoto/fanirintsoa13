# ============================================================
# MESSAGES PRO — Chat
# ============================================================
@app.route("/users/list")
def users_list():
    """Liste des utilisateurs pour choisir destinataire."""
    uid, err = require_auth(request)
    if err: return err
    c = connect()
    rows = c.execute("""SELECT id, username, prenom, email, role, photo
                        FROM users WHERE id != ? AND active = 1
                        ORDER BY username""", (uid,)).fetchall()
    c.close()
    return jsonify([dict(r) for r in rows])

@app.route("/messages/conversations")
def conversations_list():
    """Liste des conversations (dernier message par interlocuteur)."""
    uid, err = require_auth(request)
    if err: return err
    c = connect()
    # Récupérer tous les interlocuteurs uniques
    rows = c.execute("""
        SELECT
            CASE
                WHEN sender_id = ? THEN receiver_id
                ELSE sender_id
            END AS other_id,
            MAX(id) AS last_id
        FROM messages
        WHERE (sender_id = ? OR receiver_id = ?)
          AND sender_id IS NOT NULL
          AND receiver_id IS NOT NULL
        GROUP BY other_id
        ORDER BY last_id DESC
    """, (uid, uid, uid)).fetchall()

    result = []
    for r in rows:
        other_id = r["other_id"]
        other = c.execute("""SELECT id, username, prenom, email, role, photo
                             FROM users WHERE id=?""", (other_id,)).fetchone()
        if not other: continue
        last = c.execute("SELECT * FROM messages WHERE id=?", (r["last_id"],)).fetchone()
        unread = c.execute("""SELECT COUNT(*) FROM messages
                              WHERE sender_id=? AND receiver_id=? AND lu=0""",
                           (other_id, uid)).fetchone()[0]
        result.append({
            "user": dict(other),
            "last_message": dict(last) if last else None,
            "unread": unread,
        })
    c.close()
    return jsonify(result)

@app.route("/messages/with/<int:other_id>")
def conversation_with(other_id):
    """Tous les messages échangés entre moi et other_id."""
    uid, err = require_auth(request)
    if err: return err
    c = connect()
    rows = c.execute("""
        SELECT * FROM messages
        WHERE (sender_id = ? AND receiver_id = ?)
           OR (sender_id = ? AND receiver_id = ?)
        ORDER BY id ASC
    """, (uid, other_id, other_id, uid)).fetchall()
    # Marquer comme lus les messages reçus
    c.execute("""UPDATE messages SET lu=1
                 WHERE sender_id=? AND receiver_id=? AND lu=0""",
              (other_id, uid))
    c.commit()
    result = [dict(r) for r in rows]
    c.close()
    return jsonify(result)

@app.route("/messages/send", methods=["POST"])
def send_message_pro():
    """Envoyer un message à un utilisateur."""
    uid, err = require_auth(request)
    if err: return err
    d = request.json or {}
    receiver_id = d.get("receiver_id")
    contenu = (d.get("contenu") or "").strip()
    sujet = d.get("sujet", "")

    if not receiver_id or not contenu:
        return jsonify({"error": "Mila destinataire sy contenu"}), 400

    c = connect()
    # Vérifier que le destinataire existe
    r = c.execute("SELECT id, username FROM users WHERE id=?", (receiver_id,)).fetchone()
    if not r:
        c.close(); return jsonify({"error": "Tsy hita ny destinataire"}), 404

    # Récupérer mon username
    me = c.execute("SELECT username, prenom FROM users WHERE id=?", (uid,)).fetchone()

    cur = c.execute("""INSERT INTO messages
        (expediteur, destinataire, sender_id, receiver_id, sujet, contenu, lu)
        VALUES (?,?,?,?,?,?,0)""",
        (me["prenom"] or me["username"], r["username"], uid, receiver_id, sujet, contenu))
    c.commit()
    msg_id = cur.lastrowid
    row = c.execute("SELECT * FROM messages WHERE id=?", (msg_id,)).fetchone()
    c.close()
    log_action(uid, "message_send", f"to={receiver_id}")
    return jsonify(dict(row)), 201

@app.route("/messages/unread-count")
def unread_count():
    """Nombre de messages non lus."""
    uid, err = require_auth(request)
    if err: return err
    c = connect()
    n = c.execute("SELECT COUNT(*) FROM messages WHERE receiver_id=? AND lu=0", (uid,)).fetchone()[0]

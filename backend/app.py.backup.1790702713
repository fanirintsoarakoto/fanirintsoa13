def matieres_coefficients():
    uid, err = require_auth(request)
    if err: return err
    c = connect()
    rows = c.execute("""SELECT m.id, m.nom, m.coefficient, m.classe_id, cl.nom AS classe_nom
                        FROM matieres m LEFT JOIN classes cl ON cl.id = m.classe_id
                        ORDER BY m.nom""").fetchall()
    c.close()
    return jsonify([dict(r) for r in rows])

@app.route("/matieres/coefficients/bulk", methods=["PUT"])
def update_coefficients_bulk():
    uid, err = require_permission(request, "settings.manage")
    if err: return err
    d = request.json or {}
    items = d.get("items", [])
    c = connect()
    for it in items:
        mid = it.get("id"); coef = it.get("coefficient")
        if mid and coef is not None:
            c.execute("UPDATE matieres SET coefficient=? WHERE id=?", (int(coef), mid))
    c.commit(); c.close()
    return jsonify({"ok": True, "updated": len(items)})


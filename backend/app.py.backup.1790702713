# ============================================================
# STUDENTS
# ============================================================
def student_full(c, sid):
    return dict(c.execute("""SELECT s.*, cl.nom AS classe_nom, g.nom AS groupe_nom,
                                    f.nom AS filiere_nom FROM students s
                             LEFT JOIN classes cl ON cl.id = s.classe_id
                             LEFT JOIN groupes g ON g.id = s.groupe_id
                             LEFT JOIN filieres f ON f.id = s.filiere_id
                             WHERE s.id=?""", (sid,)).fetchone() or {})

@app.route("/students")
def list_students():
    uid, err = require_permission(request, "students.view")
    if err: return err
    a = request.args
    q = """SELECT s.*, cl.nom AS classe_nom, g.nom AS groupe_nom, f.nom AS filiere_nom
           FROM students s LEFT JOIN classes cl ON cl.id = s.classe_id
           LEFT JOIN groupes g ON g.id = s.groupe_id
           LEFT JOIN filieres f ON f.id = s.filiere_id WHERE 1=1"""
    p = []
    if a.get("search"):
        s = f"%{a.get('search')}%"
        q += " AND (s.nom LIKE ? OR s.prenom LIKE ? OR s.matricule LIKE ?)"
        p += [s, s, s]
    if a.get("classe_id"): q += " AND s.classe_id=?"; p.append(a.get("classe_id"))
    if a.get("sexe"): q += " AND s.sexe=?"; p.append(a.get("sexe"))
    q += " ORDER BY s.nom COLLATE NOCASE"
    c = connect()
    rows = c.execute(q, p).fetchall()
    c.close()
    return jsonify([dict(r) for r in rows])

@app.route("/students/advanced")
def search_students():
    uid, err = require_permission(request, "students.view")
    if err: return err
    a = request.args
    q = """SELECT s.*, cl.nom AS classe_nom, f.nom AS filiere_nom
           FROM students s LEFT JOIN classes cl ON cl.id = s.classe_id
           LEFT JOIN filieres f ON f.id = s.filiere_id WHERE 1=1"""
    p = []
    if a.get("q"):
        s = f"%{a.get('q')}%"
        q += " AND (s.matricule LIKE ? OR s.nom LIKE ? OR s.prenom LIKE ?)"
        p += [s, s, s]
    for k, col in [("classe_id","s.classe_id"),("filiere_id","s.filiere_id"),("sexe","s.sexe")]:
        if a.get(k): q += f" AND {col}=?"; p.append(a.get(k))
    if a.get("statut") == "avec_paiement":
        q += " AND s.id IN (SELECT student_id FROM paiements WHERE statut='paye')"
    elif a.get("statut") == "sans_paiement":
        q += " AND s.id NOT IN (SELECT student_id FROM paiements WHERE statut='paye')"
    q += " ORDER BY s.nom COLLATE NOCASE"
    c = connect()
    rows = c.execute(q, p).fetchall()
    c.close()
    return jsonify([dict(r) for r in rows])

@app.route("/students/export-csv")
def export_csv():
    uid, err = require_permission(request, "students.view")
    if err: return err
    c = connect()
    rows = c.execute("""SELECT s.matricule, s.nom, s.prenom, s.sexe, s.age, s.lieu,
                               s.parent_nom, s.parent_telephone, cl.nom AS classe
                        FROM students s LEFT JOIN classes cl ON cl.id = s.classe_id
                        ORDER BY s.nom""").fetchall()
    c.close()
    lines = ["matricule,nom,prenom,sexe,age,lieu,parent_nom,parent_telephone,classe"]
    for r in rows:
        lines.append(",".join([str(x or "").replace(",", " ") for x in dict(r).values()]))
    return send_file(io.BytesIO("\n".join(lines).encode("utf-8")),
                     mimetype="text/csv", download_name="eleves.csv", as_attachment=True)

@app.route("/students", methods=["POST"])
def add_student():
    uid, err = require_permission(request, "students.create")
    if err: return err
    d = request.json
    nom = (d.get("nom") or "").strip()
    prenom = (d.get("prenom") or "").strip()
    if not nom or not prenom:
        return jsonify({"error": "Mila anarana sy fanampiny"}), 400
    matricule = (d.get("matricule") or "").strip() or gen_matricule()
    age = d.get("age") or compute_age(d.get("date_naissance"))
    c = connect()
    if c.execute("SELECT id FROM students WHERE matricule=?", (matricule,)).fetchone():
        c.close(); return jsonify({"error": "Efa misy"}), 400
    cur = c.execute("""INSERT INTO students
        (matricule, nom, prenom, date_naissance, age, sexe, lieu, telephone,
         parent_nom, parent_telephone, classe_id, groupe_id, filiere_id, situation, photo)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
        (matricule, nom, prenom, d.get("date_naissance"), age,
         d.get("sexe","M"), d.get("lieu",""), d.get("telephone",""),
         d.get("parent_nom",""), d.get("parent_telephone",""),
         d.get("classe_id"), d.get("groupe_id"), d.get("filiere_id"),
         d.get("situation",""), d.get("photo","")))
    c.commit()
    result = student_full(c, cur.lastrowid)
    c.close()
    log_action(uid, "student_create", f"{nom} {prenom}")
    return jsonify(result), 201

@app.route("/students/<int:sid>")
def get_student(sid):
    uid, err = require_permission(request, "students.view")
    if err: return err
    c = connect()
    s = student_full(c, sid)
    if not s:
        c.close(); return jsonify({"error": "Tsy hita"}), 404
    hist = c.execute("SELECT * FROM attendance WHERE student_id=? ORDER BY date DESC LIMIT 60", (sid,)).fetchall()
    stats = {
        "present": c.execute("SELECT COUNT(*) FROM attendance WHERE student_id=? AND statut='present'", (sid,)).fetchone()[0],
        "absent": c.execute("SELECT COUNT(*) FROM attendance WHERE student_id=? AND statut='absent'", (sid,)).fetchone()[0],
        "retard": c.execute("SELECT COUNT(*) FROM attendance WHERE student_id=? AND statut='retard'", (sid,)).fetchone()[0],
    }
    total = sum(stats.values())
    stats["total"] = total
    stats["taux"] = round((stats["present"] + stats["retard"]) / total * 100, 1) if total else 0
    c.close()
    return jsonify({**s, "history": [dict(h) for h in hist], "stats": stats})

@app.route("/students/<int:sid>/situation")
def student_situation(sid):
    uid, err = require_permission(request, "students.view")
    if err: return err
    c = connect()
    s = c.execute("SELECT s.*, cl.nom AS classe_nom FROM students s LEFT JOIN classes cl ON cl.id = s.classe_id WHERE s.id=?", (sid,)).fetchone()
    if not s:
        c.close(); return jsonify({"error": "Tsy hita"}), 404
    frais = c.execute("SELECT * FROM frais WHERE classe_id IS NULL OR classe_id=?", (s["classe_id"],)).fetchall()
    total_du = sum(f["montant"] for f in frais)
    paiements = c.execute("SELECT * FROM paiements WHERE student_id=?", (sid,)).fetchall()
    total_paye = sum(p["montant"] for p in paiements if p["statut"] == "paye")
    c.close()
    return jsonify({"student": dict(s), "frais": [dict(f) for f in frais],
                    "total_du": total_du, "total_paye": total_paye,
                    "reste": total_du - total_paye,
                    "paiements": [dict(p) for p in paiements]})

@app.route("/students/<int:sid>", methods=["PUT"])
def update_student(sid):
    uid, err = require_permission(request, "students.update")
    if err: return err
    d = request.json or {}
    fields, vals = [], []
    for k in ["matricule","nom","prenom","date_naissance","age","sexe","lieu",
              "telephone","parent_nom","parent_telephone","classe_id","groupe_id",
              "filiere_id","situation","photo"]:
        if k in d: fields.append(f"{k}=?"); vals.append(d[k])
    if "date_naissance" in d and "age" not in d:
        fields.append("age=?"); vals.append(compute_age(d["date_naissance"]))
    fields.append("updated_at=CURRENT_TIMESTAMP")
    vals.append(sid)
    c = connect()
    c.execute(f"UPDATE students SET {', '.join(fields)} WHERE id=?", vals)
    c.commit()
    r = student_full(c, sid)
    c.close()
    return jsonify(r) if r else (jsonify({"error": "Tsy hita"}), 404)


@app.route("/parametres", methods=["PUT"])
def update_parametres():
    uid, err = require_permission(request, "settings.manage")
    if err: return err
    d = request.json or {}
    c = connect()
    for k, v in d.items():
        c.execute("""INSERT INTO parametres (cle, valeur) VALUES (?,?)
                     ON CONFLICT(cle) DO UPDATE SET valeur=excluded.valeur""", (k, str(v)))
    c.commit(); c.close()
    return jsonify({"ok": True})


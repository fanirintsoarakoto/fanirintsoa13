@app.route("/users")
def list_users():
    uid, err = require_permission(request, "users.view")
    if err: return err
    c = connect()
    rows = c.execute("SELECT id,username,email,role,active,prenom,telephone,photo,created_at,last_login FROM users ORDER BY username").fetchall()
    c.close()
    return jsonify([dict(r) for r in rows])

@app.route("/users", methods=["POST"])
def add_user():
    uid, err = require_permission(request, "users.create")
    if err: return err
    d = request.json
    u = (d.get("username") or "").strip()
    e = (d.get("email") or "").strip()
    p = d.get("password") or ""
    if not u or not e or not p:
        return jsonify({"error": "Mila username, email, password"}), 400
    c = connect()
    if c.execute("SELECT id FROM users WHERE username=?", (u,)).fetchone():
        c.close(); return jsonify({"error": "Efa misy"}), 400
    cur = c.execute("INSERT INTO users (username,email,password_hash,role,active,prenom,telephone,photo) VALUES (?,?,?,?,1,?,?,?)",
                    (u, e, hash_password(p), d.get("role","secretaire"),
                     d.get("prenom",""), d.get("telephone",""), d.get("photo","")))
    c.commit()
    row = c.execute("SELECT id,username,email,role,active,prenom,telephone,photo FROM users WHERE id=?",
                    (cur.lastrowid,)).fetchone()
    c.close()
    log_action(uid, "user_create", u)
    return jsonify(dict(row)), 201

@app.route("/users/<int:uid2>", methods=["PUT"])
def update_user(uid2):
    uid, err = require_permission(request, "users.update")
    if err: return err
    d = request.json or {}
    fields, vals = [], []
    for k in ["role","prenom","telephone","photo","email"]:
        if k in d: fields.append(f"{k}=?"); vals.append(d[k])
    if "active" in d: fields.append("active=?"); vals.append(1 if d["active"] else 0)
    if d.get("password"): fields.append("password_hash=?"); vals.append(hash_password(d["password"]))
    if not fields: return jsonify({"error": "Tsy misy"}), 400
    vals.append(uid2)
    c = connect()
    c.execute(f"UPDATE users SET {', '.join(fields)} WHERE id=?", vals)
    c.commit()
    row = c.execute("SELECT id,username,email,role,active,prenom,telephone,photo FROM users WHERE id=?", (uid2,)).fetchone()
    c.close()
    return jsonify(dict(row)) if row else (jsonify({"error": "Tsy hita"}), 404)

@app.route("/users/<int:uid2>", methods=["DELETE"])
def del_user(uid2):
    uid, err = require_permission(request, "users.delete")
    if err: return err
    if uid == uid2: return jsonify({"error": "Tsy afaka mamafa tenanao"}), 400
    c = connect()
    c.execute("DELETE FROM sessions_auth WHERE user_id=?", (uid2,))
    c.execute("DELETE FROM user_permissions WHERE user_id=?", (uid2,))
    c.execute("DELETE FROM users WHERE id=?", (uid2,))
    c.commit(); c.close()
    log_action(uid, "user_delete", f"id={uid2}")
    return jsonify({"ok": True})

@app.route("/users/<int:uid2>/reset-password", methods=["POST"])
def reset_pwd(uid2):
    uid, err = require_permission(request, "users.update")
    if err: return err
    d = request.json or {}
    new = d.get("password") or "1234"
    c = connect()
    c.execute("UPDATE users SET password_hash=?, login_attempts=0, locked_until=NULL WHERE id=?",
              (hash_password(new), uid2))
    c.commit(); c.close()
    return jsonify({"ok": True})


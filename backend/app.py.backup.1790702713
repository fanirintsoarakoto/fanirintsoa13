@app.route("/messages/<int:mid>", methods=["DELETE"])
def del_message_pro(mid):
    uid, err = require_auth(request)
    if err: return err
    c = connect()
    m = c.execute("SELECT * FROM messages WHERE id=?", (mid,)).fetchone()
    if not m:
        c.close(); return jsonify({"error": "Tsy hita"}), 404
    if m["sender_id"] != uid and m["receiver_id"] != uid:
        c.close(); return jsonify({"error": "Tsy manana alalana"}), 403
    c.execute("DELETE FROM messages WHERE id=?", (mid,))
    c.commit(); c.close()
    return jsonify({"ok": True})


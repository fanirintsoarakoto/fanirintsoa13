@app.route("/notifications/auto", methods=["POST"])
def auto_notifications():
    uid, err = require_auth(request)
    if err: return err
    d = request.json or {}
    type_ = d.get("type")
    c = connect()
    count = 0
    if type_ == "absences":
        today = datetime.now().strftime("%Y-%m-%d")
        rows = c.execute("""SELECT s.nom, s.prenom FROM attendance a
                            JOIN students s ON s.id = a.student_id
                            WHERE a.date=? AND a.statut='absent'""", (today,)).fetchall()
        for r in rows:
            c.execute("INSERT INTO notifications (type, titre, contenu) VALUES ('absence', ?, ?)",
                      (f"Absence: {r['nom']} {r['prenom']}", f"Tsy tonga {today}"))
            count += 1
    c.commit(); c.close()
    return jsonify({"ok": True, "count": count})


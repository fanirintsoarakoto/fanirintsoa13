@app.route("/profile", methods=["PUT"])
def update_profile():
    uid, err = require_auth(request)
    if err: return err
    d = request.json or {}
    fields, vals = [], []
    for k in ["prenom","telephone","email","photo"]:
        if k in d: fields.append(f"{k}=?"); vals.append(d[k])
    if not fields: return jsonify({"error": "Tsy misy"}), 400
    vals.append(uid)
    c = connect()
    c.execute(f"UPDATE users SET {', '.join(fields)} WHERE id=?", vals)
    c.commit(); c.close()
    return jsonify({"ok": True})

@app.route("/profile/password", methods=["PUT"])
def update_my_pwd():
    uid, err = require_auth(request)
    if err: return err
    d = request.json or {}
    old = d.get("old_password") or ""
    new = d.get("new_password") or ""
    if len(new) < 4: return jsonify({"error": "Fohy loatra"}), 400
    c = connect()
    u = c.execute("SELECT password_hash FROM users WHERE id=?", (uid,)).fetchone()
    if not u or not verify_password(old, u["password_hash"]):
        c.close(); return jsonify({"error": "Diso"}), 400
    c.execute("UPDATE users SET password_hash=? WHERE id=?", (hash_password(new), uid))
    c.commit(); c.close()
    return jsonify({"ok": True})

